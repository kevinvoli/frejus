# Copier ce fichier en .env (jamais commité) et adapter les valeurs.
# Pour générer un .env local prêt à l'emploi automatiquement, redemander à Claude.

# --- Serveur ---
PORT=3000
# Origine(s) autorisée(s) à appeler l'API (séparées par des virgules). "*" en local.
CORS_ORIGIN=*

# --- Base de données MySQL ---
# En local avec `docker compose up` (voir docker-compose.yml), DB_HOST/DB_PORT sont de
# toute façon forcés sur le conteneur MySQL ("db"/3306) par le service "api" : la valeur
# ci-dessous ne sert que si vous lancez l'API hors Docker (npm run start:dev) contre le
# MySQL du docker-compose (port 3306 publié sur la machine hôte).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=frejus
DB_PASSWORD=frejus
DB_DATABASE=frejus
# Mot de passe root MySQL, utilisé uniquement par docker-compose.yml / docker-compose.prod.yml
# à la création du conteneur (pas lu par l'API elle-même). À générer, par exemple avec :
# openssl rand -base64 18
DB_ROOT_PASSWORD=change-me-please
# true en MVP/dev (les tables sont créées/adaptées automatiquement depuis les entités).
# A passer à false + mettre en place de vraies migrations TypeORM avant la production.
DB_SYNCHRONIZE=true

# --- Authentification admin ---
# Secret utilisé pour signer les JWT de l'espace admin. À générer aléatoirement,
# par exemple avec : openssl rand -base64 48
JWT_SECRET=change-me-in-.env
JWT_EXPIRES_IN=12h

# Compte admin créé automatiquement au premier démarrage si la table admin_users est vide.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
