# URL de l'API backend (voir ../backend). En développement local, le backend tourne
# par défaut sur le port 3000. En production, pointer vers l'URL publique de l'API
# (attention : comme pour l'admin, Vite grave cette valeur en dur dans le build —
# voir .github/workflows/deploy.yml et le secret GitHub correspondant si besoin).
VITE_API_URL=http://localhost:3000/api
