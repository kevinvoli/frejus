# Fichier .env de /opt/apps/frejus sur le VPS. Copier en `.env`, remplir, puis
# `chmod 600 .env`. NE JAMAIS COMMITER le fichier rempli.
#
# Générer les secrets sur le VPS :
#   openssl rand -base64 18   (mots de passe)
#   openssl rand -base64 48   (JWT_SECRET)

# --- Domaines (enregistrements DNS A pointant vers l'IP du VPS) ---
# Lus aussi par /opt/infrastructure/nginx/nginx-apply.sh pour générer la conf Nginx.
SITE_DOMAIN=pixellia.fr
API_DOMAIN=api.pixellia.fr
ADMIN_DOMAIN=admin.pixellia.fr
# Adresse utilisée par Let's Encrypt pour les alertes d'expiration.
ACME_EMAIL=contact@pixellia.fr

# --- Images Docker (réécrites à chaque déploiement par deploy.sh) ---
FRONTEND_IMAGE=ghcr.io/kevinvoli/frejus-frontend:latest
BACKEND_IMAGE=ghcr.io/kevinvoli/frejus-backend:latest
ADMIN_IMAGE=ghcr.io/kevinvoli/frejus-admin:latest

# --- API ---
# Origines autorisées à appeler l'API, séparées par des virgules.
# Ne JAMAIS laisser "*" en production : l'admin s'authentifie en JWT.
CORS_ORIGIN=https://pixellia.fr,https://admin.pixellia.fr

# --- Base de données (instance MySQL mutualisée /opt/infrastructure/mysql) ---
# DB_HOST/DB_PORT sont forcés sur "mysql:3306" par docker-compose.yml.
# Ces identifiants doivent avoir été créés au préalable avec :
#   /opt/infrastructure/mysql/create-app-db.sh frejus frejus <DB_PASSWORD>
DB_USERNAME=frejus
DB_PASSWORD=CHANGE-ME
DB_DATABASE=frejus
# true tant qu'il n'y a pas de migrations TypeORM : les tables sont créées depuis
# les entités au démarrage. Voir docs/ANALYSE-PLAN-BACKEND.md avant de passer à false.
DB_SYNCHRONIZE=true

# --- Authentification admin ---
JWT_SECRET=CHANGE-ME
JWT_EXPIRES_IN=12h

# Compte admin créé au premier démarrage si la table admin_users est vide.
# Changer le mot de passe depuis le panneau juste après le premier login.
ADMIN_EMAIL=admin@pixellia.fr
ADMIN_PASSWORD=CHANGE-ME
