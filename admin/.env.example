# Copier ce fichier en .env.local (ignoré par Git) pour le développement local.
# Attention : cette valeur est "figée" dans le bundle JS au moment du `npm run build`
# (comportement standard de Vite) — pas une variable lue au démarrage du serveur.

# URL de base de l'API backend (voir backend/README.md pour les routes disponibles).
VITE_API_URL=http://localhost:3000/api

# URL du site vitrine, utilisée pour construire le lien de galerie partagé au client
# (page Médiathèque : "/?galerie=<token>").
VITE_FRONTEND_URL=http://localhost:5173
